# Flask
SECRET_KEY=change-me-to-a-random-string
APP_ENV=development

# API Authentication — shared secret between your main app and this server
API_KEY=change-me-to-a-secret-shared-between-apps

# Telegram Admin Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
