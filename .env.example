# Firebase Admin (optional)
FIREBASE_CREDENTIALS_PATH=

# Merchant Info — the phone number users send Mobile Money TO
MERCHANT_PHONE=0782123456
MERCHANT_NAME=Your Business Name

# Plan Pricing (UGX)
PLAN_PRICE_DAY=2500
PLAN_PRICE_MONTHLY=15000
PLAN_PRICE_QUARTERLY=40000
