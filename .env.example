# ═══════════════════════════════════════════════════════════
# SMS Payment Verification System — Environment Variables
# ═══════════════════════════════════════════════════════════

# Flask secret key — MUST be 32+ random chars
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# API Authentication — shared secret between your main app and this server
# MUST be 24+ random chars
API_KEY=change-me-to-a-secret-shared-between-apps

# Webhook HMAC secret — used to verify incoming SMS webhook payloads
# If not set, falls back to SECRET_KEY
WEBHOOK_SECRET=

# App environment: "production" or "development"
APP_ENV=production

# Rate Limiting
WEBHOOK_RATE_LIMIT=30 per minute
GLOBAL_RATE_LIMIT=60 per minute

# Input Limits
MAX_SMS_LENGTH=500
MAX_USER_EMAIL_LENGTH=254
MAX_PHONE_LENGTH=20

# Telegram Admin Notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Firebase Admin (optional)
FIREBASE_CREDENTIALS_PATH=

# Merchant Info — the phone number users send money TO
MERCHANT_PHONE=0782123456
MERCHANT_NAME=Your Business Name

# Plan Pricing (UGX)
PLAN_PRICE_DAY=2500
PLAN_PRICE_MONTHLY=15000
PLAN_PRICE_QUARTERLY=40000
